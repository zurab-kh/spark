<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Strela.App</RootNamespace>
    <AssemblyName>Spark</AssemblyName>
    <Product>Spark</Product>
    <ApplicationIcon>Assets\spark.ico</ApplicationIcon>
    <Company>Spark</Company>
    <StartupObject>Strela.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Strela.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Strela.Engine\Strela.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Свой Program.Main: режим native host не должен поднимать WPF. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Расширение браузера едет рядом со Spark.exe (build и dotnet publish). -->
    <Content Include="..\..\browser-extension\**\*" Link="browser-extension\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\spark.ico" />
    <Resource Include="Assets\spark-256.png" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
