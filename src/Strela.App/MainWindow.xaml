<Window x:Class="Strela.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Стрела" Height="560" Width="920" MinWidth="560" MinHeight="340"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Квадратная кнопка-значок 32×32 для действий в строке -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Строка ввода ссылки -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="InputBox" MinHeight="38" MaxHeight="110" Padding="36,8,10,8"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Ссылка для загрузки"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="InputBox_PreviewKeyDown" />
                <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Вставьте ссылку и нажмите Enter" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="38,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Grid.Column="1" Margin="8,0,0,0" MinHeight="38" Padding="18,0" VerticalAlignment="Top"
                    Style="{DynamicResource AccentButtonStyle}" Cursor="Hand"
                    Command="{Binding AddFromInputCommand}" ToolTip="Добавить ссылку (Enter)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Скачать" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding InputHint}" Margin="4,6,0,0" FontSize="12"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding InputHint}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Список загрузок -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <ListView x:Name="List" ItemsSource="{Binding Items}"
                      SelectionMode="Single" BorderThickness="0" Background="Transparent"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="Загрузки"
                      ContextMenuOpening="List_ContextMenuOpening">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick" />
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_RightClick" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" Padding="12,10" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Значок типа файла -->
                                <Grid Width="42" Height="42" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Border CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,-4,-4" Background="{DynamicResource SystemFillColorSuccessBrush}"
                                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,-4,-4" Background="{DynamicResource SystemFillColorCriticalBrush}"
                                            Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <!-- Имя, подробности, прогресс -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                    <TextBlock Text="{Binding DetailText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DetailText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ProgressBar Margin="0,8,0,0" Height="4" Minimum="0" Maximum="1"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 Visibility="{Binding ShowProgressBar, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <!-- Процент -->
                                <TextBlock Grid.Column="2" Text="{Binding ProgressText}" Margin="16,0,4,0" MinWidth="44"
                                           VerticalAlignment="Center" TextAlignment="Right" FontSize="14" FontWeight="SemiBold"
                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />

                                <!-- Действия -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="Пауза"
                                            AutomationProperties.Name="Пауза"
                                            Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Продолжить"
                                            AutomationProperties.Name="Продолжить"
                                            Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Повторить"
                                            AutomationProperties.Name="Повторить"
                                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Открыть файл"
                                            AutomationProperties.Name="Открыть файл"
                                            Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Показать в папке"
                                            AutomationProperties.Name="Показать в папке"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Открыть файл" Command="{Binding OpenFileCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.SelectedItem.IsCompleted, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Показать в папке" Command="{Binding OpenFolderCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Пауза" Command="{Binding PauseCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.SelectedItem.CanPause, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Продолжить" Command="{Binding ResumeCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.SelectedItem.CanResume, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Повторить" Command="{Binding RetryCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.SelectedItem.CanRetry, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Обновить ссылку (из буфера обмена)" Command="{Binding UpdateUrlCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Копировать ссылку" Command="{Binding CopyUrlCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Выше" Command="{Binding MoveUpCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Ниже" Command="{Binding MoveDownCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Удалить из списка" Command="{Binding RemoveCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Удалить с файлом…" Command="{Binding RemoveWithFileCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <!-- Пустое состояние -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Загрузок пока нет" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,6,0,0" TextAlignment="Center"
                           Text="Вставьте ссылку сверху, перетащите её в окно&#10;или просто скопируйте — Стрела предложит скачать." />
            </StackPanel>
        </Grid>

        <!-- Строка состояния -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                           Margin="2,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding TotalsText}" Style="{StaticResource SecondaryText}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Padding="12,6" Click="Settings_Click" Cursor="Hand" ToolTip="Настройки"
                    AutomationProperties.Name="Настройки">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Настройки" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
