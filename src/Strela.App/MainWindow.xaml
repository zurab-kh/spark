<Window x:Class="Strela.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spark" Height="560" Width="920" MinWidth="560" MinHeight="340"
        Icon="pack://application:,,,/Spark;component/Assets/spark.ico"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Цвета из макета Spark (Superdesign). Полупрозрачные заливки читаются и в тёмной, и в светлой теме. -->
        <SolidColorBrush x:Key="PausedBrush" Color="#F7630C" />
        <SolidColorBrush x:Key="ErrorCardBrush" Color="#1FC42B1C" />
        <SolidColorBrush x:Key="ErrorCardStrokeBrush" Color="#66C42B1C" />
        <LinearGradientBrush x:Key="SparkGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FFB300" />
            <GradientStop Offset="0.5" Color="#FF6A1A" />
            <GradientStop Offset="1" Color="#FF2D7A" />
        </LinearGradientBrush>

        <!-- Значок типа файла: цвет по виду файла -->
        <Style x:Key="TypeBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#269CA3AF" />
            <Setter Property="TextElement.Foreground" Value="#9CA3AF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="disk">
                    <Setter Property="Background" Value="#263B82F6" />
                    <Setter Property="TextElement.Foreground" Value="#60A5FA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="archive">
                    <Setter Property="Background" Value="#26F59E0B" />
                    <Setter Property="TextElement.Foreground" Value="#F59E0B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="app">
                    <Setter Property="Background" Value="#2622C55E" />
                    <Setter Property="TextElement.Foreground" Value="#22C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="media">
                    <Setter Property="Background" Value="#26A855F7" />
                    <Setter Property="TextElement.Foreground" Value="#C084FC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="document">
                    <Setter Property="Background" Value="#2614B8A6" />
                    <Setter Property="TextElement.Foreground" Value="#2DD4BF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="#33C42B1C" />
                    <Setter Property="TextElement.Foreground" Value="#FF6B6B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Карточка загрузки; ошибка — красная -->
        <Style x:Key="DownloadCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ErrorCardBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorCardStrokeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Тонкая полоска прогресса: синяя при загрузке, оранжевая на паузе -->
        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <!-- PART_Track / PART_Indicator: ProgressBar сам выставляет ширину заполнения -->
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="1.5" Background="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                            <Border x:Name="PART_Indicator" CornerRadius="1.5" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PausedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Тихая кнопка-значок без рамки, как в макете -->
        <Style x:Key="GhostIconButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Квадратная кнопка-значок 32×32 для действий в строке -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Строка ввода ссылки -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="InputBox" MinHeight="38" MaxHeight="110" Padding="36,8,10,8"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Ссылка для загрузки"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="InputBox_PreviewKeyDown" />
                <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Вставьте ссылку и нажмите Enter" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="38,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Grid.Column="1" Margin="8,0,0,0" MinHeight="38" Padding="18,0" VerticalAlignment="Top"
                    Style="{DynamicResource AccentButtonStyle}" Cursor="Hand"
                    Command="{Binding AddFromInputCommand}" ToolTip="Добавить ссылку (Enter)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Скачать" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding InputHint}" Margin="4,6,0,0" FontSize="12"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding InputHint}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Список загрузок -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <ListView x:Name="List" ItemsSource="{Binding Items}"
                      SelectionMode="Single" BorderThickness="0" Background="Transparent"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="Загрузки"
                      ContextMenuOpening="List_ContextMenuOpening">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick" />
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_RightClick" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DownloadCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Значок типа файла; у ошибки — предупреждение -->
                                <Border Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center" Style="{StaticResource TypeBadge}">
                                    <Grid>
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="10.5" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <!-- Имя, подробности, прогресс -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                    <TextBlock Margin="0,3,0,0" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="{Binding StatusLabel, Mode=OneWay}" FontWeight="SemiBold">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource PausedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run><Run Text="{Binding DetailTail, Mode=OneWay}">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF6B6B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                    <ProgressBar Margin="0,9,0,0" Style="{StaticResource ThinProgress}"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 Visibility="{Binding ShowProgressBar, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <!-- Процент или галочка -->
                                <Grid Grid.Column="2" Margin="18,0,6,0" MinWidth="44" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PercentText}" FontSize="15" FontWeight="SemiBold" TextAlignment="Right"
                                               Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right"
                                            Background="{DynamicResource SystemFillColorSuccessBrush}"
                                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <!-- Действия -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostIconButton}" Content="&#xE769;" ToolTip="Пауза"
                                            AutomationProperties.Name="Пауза"
                                            Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="&#xE768;" ToolTip="Продолжить" AutomationProperties.Name="Продолжить"
                                            Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostIconButton}">
                                                <Setter Property="Foreground" Value="{StaticResource PausedBrush}" />
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Повторить" Padding="14,5" Margin="4,0,0,0" Cursor="Hand"
                                            AutomationProperties.Name="Повторить"
                                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource GhostIconButton}" Content="&#xE8E5;" ToolTip="Открыть файл"
                                            AutomationProperties.Name="Открыть файл"
                                            Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource GhostIconButton}" Content="&#xE838;" ToolTip="Показать в папке"
                                            AutomationProperties.Name="Показать в папке"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Открыть файл" Command="{Binding OpenFileCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.SelectedItem.IsCompleted, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Показать в папке" Command="{Binding OpenFolderCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Пауза" Command="{Binding PauseCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.SelectedItem.CanPause, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Продолжить" Command="{Binding ResumeCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.SelectedItem.CanResume, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Повторить" Command="{Binding RetryCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.SelectedItem.CanRetry, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Обновить ссылку (из буфера обмена)" Command="{Binding UpdateUrlCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Копировать ссылку" Command="{Binding CopyUrlCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Выше" Command="{Binding MoveUpCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Ниже" Command="{Binding MoveDownCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Удалить из списка" Command="{Binding RemoveCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Удалить с файлом…" Command="{Binding RemoveWithFileCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <!-- Пустое состояние -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Image Source="pack://application:,,,/Spark;component/Assets/spark-256.png" Width="64" Height="64" HorizontalAlignment="Center" />
                <TextBlock Text="Загрузок пока нет" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock FontSize="13" Margin="0,6,0,0" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Вставьте ссылку сверху, перетащите её в окно&#10;или просто скопируйте — Spark предложит скачать." />
            </StackPanel>
        </Grid>

        <!-- Строка состояния -->
        <Border Grid.Row="3" Margin="-16,10,-16,-12" Padding="16,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="12"
                            TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SpeedTotalText}" VerticalAlignment="Center" />
                    <Ellipse Width="6" Height="6" Margin="16,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="{Binding ActiveText}" VerticalAlignment="Center" />
                    <Ellipse Width="6" Height="6" Margin="16,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding QueuedText}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Click="Settings_Click" ToolTip="Настройки" AutomationProperties.Name="Настройки">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostIconButton}">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Padding" Value="10,0" />
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Настройки" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
