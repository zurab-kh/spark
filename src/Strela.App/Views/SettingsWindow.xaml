<Window x:Class="Strela.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- Карточка настройки в стиле параметров Windows 11 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="CardIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,14,0,8" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,8,20,20">
        <TextBlock Text="Загрузки" Style="{StaticResource Section}" />

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE838;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Папка загрузок" />
                    <TextBox x:Name="FolderBox" Margin="0,6,0,0" MinHeight="32" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Папка загрузок" />
                    <TextBlock Text="Пусто — системная папка «Загрузки»" Style="{StaticResource Hint}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Выбрать…" Margin="12,0,0,0" Padding="14,6" VerticalAlignment="Center"
                        Click="Browse_Click" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8CB;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Соединений на файл" />
                    <TextBlock Text="Больше соединений — быстрее на серверах с ограничением скорости. 1–32, по умолчанию 16."
                               Style="{StaticResource Hint}" />
                </StackPanel>
                <TextBox Grid.Column="2" x:Name="ConnectionsBox" Width="72" Margin="12,0,0,0" MinHeight="32"
                         VerticalContentAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"
                         AutomationProperties.Name="Соединений на файл" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8FD;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Одновременных загрузок" />
                    <TextBlock Text="Остальные ждут в очереди. 1–10, по умолчанию 3." Style="{StaticResource Hint}" />
                </StackPanel>
                <TextBox Grid.Column="2" x:Name="ActiveBox" Width="72" Margin="12,0,0,0" MinHeight="32"
                         VerticalContentAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"
                         AutomationProperties.Name="Одновременных загрузок" />
            </Grid>
        </Border>

        <TextBlock Text="Поведение" Style="{StaticResource Section}" />

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE77F;" Style="{StaticResource CardIcon}" />
                <CheckBox Grid.Column="1" x:Name="ClipboardCheck" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Следить за буфером обмена" />
                        <TextBlock Text="Скопировали ссылку на файл — Spark предложит скачать" Style="{StaticResource Hint}" />
                    </StackPanel>
                </CheckBox>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xEA8F;" Style="{StaticResource CardIcon}" />
                <CheckBox Grid.Column="1" x:Name="NotifyCheck" Content="Уведомлять о завершении загрузки" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE774;" Style="{StaticResource CardIcon}" />
                <CheckBox Grid.Column="1" x:Name="BrowserCheck" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Перехватывать загрузки браузера" />
                        <TextBlock Text="Расширение Spark для Chrome/Edge: папка browser-extension рядом со Spark.exe → chrome://extensions → Режим разработчика → Загрузить распакованное"
                                   Style="{StaticResource Hint}" />
                    </StackPanel>
                </CheckBox>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7E8;" Style="{StaticResource CardIcon}" />
                <CheckBox Grid.Column="1" x:Name="AutostartCheck" Content="Запускать вместе с Windows" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сохранить" Padding="22,7" Click="Save_Click" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Закрыть" Padding="22,7" Margin="8,0,0,0" Click="Close_Click" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
