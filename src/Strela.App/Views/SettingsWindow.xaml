<Window x:Class="Strela.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="Папка загрузок" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="FolderBox" VerticalContentAlignment="Center" MinHeight="32" />
        <Button Grid.Row="0" Grid.Column="2" Content="Выбрать…" Margin="8,0,0,0" Padding="12,5" Click="Browse_Click" />
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,12"
                   Text="Пусто — системная папка «Загрузки»" FontSize="12"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

        <TextBlock Grid.Row="2" Text="Соединений на файл (1–32)" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ConnectionsBox" Width="80" HorizontalAlignment="Left" MinHeight="32" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="3" Text="Одновременных загрузок (1–10)" VerticalAlignment="Center" Margin="0,8,12,0" />
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ActiveBox" Width="80" HorizontalAlignment="Left" Margin="0,8,0,0" MinHeight="32" VerticalContentAlignment="Center" />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <CheckBox x:Name="ClipboardCheck" Content="Следить за буфером обмена" />
            <CheckBox x:Name="NotifyCheck" Content="Уведомлять о завершении загрузки" Margin="0,6,0,0" />
            <CheckBox x:Name="AutostartCheck" Content="Запускать вместе с Windows" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" Padding="18,6" Click="Save_Click" IsDefault="True" />
            <Button Content="Закрыть" Padding="18,6" Margin="8,0,0,0" Click="Close_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
