<Window x:Class="Strela.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowActivated="False"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight" MinWidth="320" MaxWidth="420"
        WindowStartupLocation="Manual">
    <Border CornerRadius="8" BorderThickness="1" Padding="16,14" Margin="8"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="32" Height="32" CornerRadius="6" VerticalAlignment="Top" Margin="0,0,12,0"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Spark" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
                <Button x:Name="ActionButton" Margin="0,12,0,0" Padding="18,6" HorizontalAlignment="Left"
                        Style="{DynamicResource AccentButtonStyle}" Cursor="Hand"
                        Visibility="Collapsed" Click="ActionButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
