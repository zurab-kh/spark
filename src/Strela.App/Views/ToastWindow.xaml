<Window x:Class="Strela.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowActivated="False"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight" MaxWidth="420"
        WindowStartupLocation="Manual">
    <Border BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Padding="14,12">
        <StackPanel>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" />
            <Button x:Name="ActionButton" Margin="0,10,0,0" Padding="16,5" HorizontalAlignment="Right"
                    Visibility="Collapsed" Click="ActionButton_Click" />
        </StackPanel>
    </Border>
</Window>
