<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Strela.App.Views.SettingsWindow"
        Title="Настройки Spark" Width="580" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,14,0,6" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="20,6,20,20">
        <TextBlock Text="Загрузки" Classes="section" />
        <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Папка загрузок" />
                    <TextBox x:Name="FolderBox" Margin="0,6,0,0" Watermark="~/Downloads" />
                    <TextBlock Text="Пусто — системная папка «Загрузки»" Classes="hint" />
                </StackPanel>
                <Button Grid.Column="1" Content="Выбрать…" Margin="12,0,0,0" Padding="14,6" VerticalAlignment="Center"
                        Click="Browse_Click" />
            </Grid>
        </Border>
        <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Соединений на файл" />
                    <TextBlock Text="Авто: Spark сам подбирает число соединений под сервер (до 32)." Classes="hint" />
                </StackPanel>
                <ComboBox Grid.Column="1" x:Name="ConnectionsCombo" MinWidth="190" Margin="12,0,0,0" VerticalAlignment="Center"
                          MaxDropDownHeight="300" />
            </Grid>
        </Border>
        <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Одновременных загрузок" />
                    <TextBlock Text="Остальные ждут в очереди. 1–10, по умолчанию 3." Classes="hint" />
                </StackPanel>
                <NumericUpDown Grid.Column="1" x:Name="ActiveBox" Minimum="1" Maximum="10" Increment="1" FormatString="0"
                               Width="120" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Видео с YouTube" />
                    <TextBlock Text="Вставьте ссылку на ролик. При первой загрузке Spark скачает yt-dlp, ffmpeg и deno (около 110 МБ)."
                               Classes="hint" />
                </StackPanel>
                <ComboBox Grid.Column="1" x:Name="VideoCombo" MinWidth="190" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock Text="Поведение" Classes="section" />
        <Border Classes="card">
            <StackPanel>
                <CheckBox x:Name="ClipboardCheck" Content="Следить за буфером обмена" />
                <TextBlock Text="Скопировали ссылку на файл, magnet или видео YouTube — Spark предложит скачать" Classes="hint" Margin="28,0,0,0" />
            </StackPanel>
        </Border>
        <Border Classes="card">
            <CheckBox x:Name="NotifyCheck" Content="Уведомлять о завершении загрузки" />
        </Border>
        <Border Classes="card">
            <StackPanel>
                <CheckBox x:Name="BrowserCheck" Content="Перехватывать загрузки браузера" />
                <TextBlock Classes="hint" Margin="28,0,0,0"
                           Text="Chrome, Edge, Brave, Arc, Яндекс: chrome://extensions → Режим разработчика → Загрузить распакованное → папка расширения (кнопка ниже; в окне выбора Cmd+Shift+G и вставьте путь)." />
                <Button Content="Показать папку расширения" Margin="28,8,0,0" Padding="14,5" Click="ShowExtension_Click" />
            </StackPanel>
        </Border>
        <Border Classes="card">
            <CheckBox x:Name="AutostartCheck" Content="Запускать при входе в систему" />
        </Border>
        <Border Classes="card">
            <StackPanel>
                <CheckBox x:Name="TorrentsCheck" Content="Открывать magnet и .torrent в Spark" />
                <TextBlock Text="Magnet-ссылки из браузера и двойной клик по .torrent-файлу запускают загрузку в Spark" Classes="hint" Margin="28,0,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="О программе" Classes="section" />
        <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Text="Spark" />
                    <TextBlock x:Name="UpdateText" Text="Новые версии приходят сами" Classes="hint" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="RestartButton" Content="Перезапустить" Padding="14,6" IsVisible="False" Click="Restart_Click"
                            Background="{StaticResource SparkGradient}" Foreground="White" />
                    <Button x:Name="CheckButton" Content="Проверить обновления" Padding="14,6" Click="Check_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" Spacing="8">
            <Button Content="Закрыть" Padding="22,7" Click="Close_Click" IsCancel="True" />
            <Button Content="Сохранить" Padding="22,7" Click="Save_Click" IsDefault="True"
                    Background="{StaticResource SparkGradient}" Foreground="White" />
        </StackPanel>
    </StackPanel>
</Window>
