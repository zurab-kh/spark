<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spark для macOS: тот же движок и те же модели представления, окно на Avalonia. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Strela.App</RootNamespace>
    <AssemblyName>Spark</AssemblyName>
    <Product>Spark</Product>
    <Company>Spark</Company>
    <Version>1.3.0</Version>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Spark.Mac.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Strela.Engine\Strela.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!-- Общий с Windows-версией код (без WPF и реестра). -->
  <ItemGroup>
    <Compile Include="..\Strela.App\ViewModels\DownloadItemViewModel.cs" Link="Shared\DownloadItemViewModel.cs" />
    <Compile Include="..\Strela.App\ViewModels\MainViewModel.cs" Link="Shared\MainViewModel.cs" />
    <Compile Include="..\Strela.App\Services\AppSettings.cs" Link="Shared\AppSettings.cs" />
    <Compile Include="..\Strela.App\Services\FileLog.cs" Link="Shared\FileLog.cs" />
    <Compile Include="..\Strela.App\Services\Format.cs" Link="Shared\Format.cs" />
    <Compile Include="..\Strela.App\Services\ISingleInstanceChannel.cs" Link="Shared\ISingleInstanceChannel.cs" />
    <Compile Include="..\Strela.App\Services\LinkParser.cs" Link="Shared\LinkParser.cs" />
    <Compile Include="..\Strela.App\Services\ManagerFactory.cs" Link="Shared\ManagerFactory.cs" />
    <Compile Include="..\Strela.App\Services\NativeMessagingFrames.cs" Link="Shared\NativeMessagingFrames.cs" />
    <Compile Include="..\Strela.App\Services\NativeMessagingHost.cs" Link="Shared\NativeMessagingHost.cs" />
    <Compile Include="..\Strela.App\Services\PipeSingleInstanceChannel.cs" Link="Shared\PipeSingleInstanceChannel.cs" />
    <Compile Include="..\Strela.App\Services\SettingsStore.cs" Link="Shared\SettingsStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Расширение браузера едет внутри Spark.app (Contents/MacOS/browser-extension). -->
    <Content Include="..\..\browser-extension\**\*"
             Link="browser-extension\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
